{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "envMode": "loose",
      "env": ["NODE_ENV", "PORT", "APP_BASE_URL", "VITE_PORTONE_STORE_ID", "VITE_PORTONE_IDENTITY_VERIFICATION_CHANNEL_KEY"],
      "outputs": ["dist/**", "build/**", ".output/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "envMode": "loose"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "envMode": "loose"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": false
    }
  }
}
