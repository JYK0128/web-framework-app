{
  "name": "service-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild build --watch",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"*.config.{js,mjs,cjs,ts,mts,cts}\" --fix",
    "codegen:entities": "mikro-orm discovery:export --path './src/entities/**/*.entity.ts' --out ./src/entities.generated.ts",
    "codegen:migration": "mikro-orm migration:create",
    "db:migrate": "mikro-orm migration:up",
    "db:seed": "mikro-orm seeder:run"
  },
  "mikro-orm": {
    "configPaths": [
      "./dist/infra/database/mikro-orm.config.js"
    ],
    "preferTs": false
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.10",
    "@mikro-orm/decorators": "7.1.10",
    "@mikro-orm/migrations": "7.1.10",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.10",
    "@mikro-orm/seeder": "7.1.10",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "12.0.0",
    "@nestjs/throttler": "6.5.0",
    "@pkg/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "^5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "lodash-es": "4.18.1",
    "nestjs-cls": "6.2.1",
    "redis": "5.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.10",
    "@pkg/config": "workspace:*",
    "@rsbuild/core": "^2.0.0",
    "@types/express": "5.0.6",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.2",
    "@types/sanitize-html": "2.16.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
