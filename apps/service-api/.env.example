# Standalone local API runtime. Docker Compose supplies its own values.
NODE_ENV=development
DEMO_ENABLED=false
PORT=4000
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use the same value in apps/admin-api/.env.example.
APP_SECRET=replace-with-43-character-base64url-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_db
REDIS_URL=redis://localhost:6379
LOKI_URL=http://localhost:3100
# Optional until S3 storage is used. All four settings are required for S3 access.
# AWS_S3_BUCKET=uploads
# AWS_S3_REGION=us-east-1
# AWS_CONFIG_FILE=/path/to/aws/rolesanywhere/config
# AWS_PROFILE=app
# Optional base URL for publicly served files.
# CDN_URL=https://d123456.cloudfront.net
# AWS_S3_ENDPOINT=https://s3.example.com
ADMIN_API_URL=http://localhost:14000
PORTONE_API_SECRET=replace-with-portone-api-secret
APP_BASE_URL=http://localhost:3000
