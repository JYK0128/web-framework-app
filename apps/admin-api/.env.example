NODE_ENV=development
PORT=14000
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use the same value in apps/service-api/.env.example.
APP_SECRET=replace-with-43-character-base64url-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/admin_db
REDIS_URL=redis://localhost:6379
LOKI_URL=http://localhost:3101
STORAGE_DRIVER=local
# Set STORAGE_DRIVER=s3 and provide these to use S3 or an S3-compatible store.
# STORAGE_S3_BUCKET=uploads
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_ACCESS_KEY_ID=replace-with-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=replace-with-secret-key
# STORAGE_S3_PUBLIC_URL_PREFIX=https://cdn.example.com/uploads
SERVICE_API_URL=http://localhost:4000
APP_BASE_URL=http://localhost:13000
PORTONE_API_SECRET=replace-with-portone-api-secret
