FROM node:24-alpine AS base

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app

FROM base AS pruner

COPY . .

ARG APP_NAME
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm dlx turbo@2.10.8 prune "${APP_NAME}" --docker

FROM base AS builder

COPY --from=pruner /app/out/json/ ./
# Install build tools before switching to the production build environment.
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

ENV NODE_ENV=production

COPY --from=pruner /app/out/full/ ./

ARG APP_NAME
# Public browser config is supplied as build args and baked into web assets.
ARG VITE_PORTONE_STORE_ID
ARG VITE_PORTONE_CHANNEL_KEY
ARG VITE_ADMIN_WEB_URL

# The web builds read PORT and API_BASE_URL from Vite config. These values are
# build-time placeholders; the container receives its real service URL at runtime.
RUN set -eu; \
    BUILD_APP_NAME="${APP_NAME}"; \
    case "${BUILD_APP_NAME}" in \
      admin-api|service-api) ;; \
      admin-web) \
        export PORT=3000 \
          API_BASE_URL=http://127.0.0.1 \
          APP_BASE_URL=http://127.0.0.1 \
          APP_NAME=admin \
          SESSION_SECRET=build-only-session-secret-not-for-runtime ;; \
      service-web) \
        export PORT=3000 \
          API_BASE_URL=http://127.0.0.1 \
          APP_BASE_URL=http://127.0.0.1 \
          APP_NAME=service \
          SESSION_SECRET=build-only-session-secret-not-for-runtime ;; \
      *) echo "Unsupported APP_NAME: ${BUILD_APP_NAME}" >&2; exit 1 ;; \
    esac; \
    pnpm exec turbo run build --env-mode=loose --filter="${BUILD_APP_NAME}..."

RUN pnpm --filter="${APP_NAME}" --prod deploy --legacy /app/deployed

FROM node:24-alpine AS runner

ENV NODE_ENV=production
WORKDIR /app

RUN apk add --no-cache tini gcompat \
  && npm install --global --no-audit --no-fund @dotenvx/dotenvx@2.19.2 \
  && npm cache clean --force \
  && addgroup -S -g 10001 app \
  && adduser -S -u 10001 -G app app \
  && mkdir -p /app/env /app/data/uploads \
  && chown -R app:app /app/env /app/data

COPY --from=builder --chown=app:app /app/deployed/ ./
# The fingerprint invalidates this layer when the mounted encrypted config changes.
ARG DOTENV_PRD_REVISION
RUN --mount=type=secret,id=DOTENV_PRD,required=true \
  printf '%s' "$DOTENV_PRD_REVISION" >/dev/null \
  && install -o app -g app -m 0400 /run/secrets/DOTENV_PRD /app/env/.env.prd

ARG APP_NAME
RUN case "${APP_NAME}" in \
      admin-web|service-web) printf 'exec node .output/server/index.mjs\n' > /app/run-app.sh ;; \
      *) printf 'exec node dist/main.js\n' > /app/run-app.sh ;; \
    esac

ARG APP_REVISION=local
LABEL org.opencontainers.image.title="${APP_NAME}" \
  org.opencontainers.image.revision="${APP_REVISION}"

USER app
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["dotenvx", "run", "-f", "/app/env/.env.prd", "--", "sh", "/app/run-app.sh"]
