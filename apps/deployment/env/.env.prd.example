# Host/runtime interpolation values for docker-compose.prd.yml.
# The CD workflow supplies these from GitHub Actions Variables and Secrets.
# App secrets such as DATABASE_URL and APP_SECRET belong in env/<app>/.env.prd.
APPS_RUNTIME_NETWORK=
ADMIN_API_PORT=
ADMIN_WEB_PORT=
SERVICE_API_PORT=
SERVICE_WEB_PORT=
ADMIN_WEB_URL=
SERVICE_WEB_URL=

# Public browser configuration, required when building either web image.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# Immutable image references. The CD workflow sets these from the deployed commit.
ADMIN_API_IMAGE=
ADMIN_WEB_IMAGE=
SERVICE_API_IMAGE=
SERVICE_WEB_IMAGE=

# Existing external volumes only. Do not point both APIs at the same uploads volume.
ADMIN_API_UPLOADS_VOLUME=
SERVICE_API_UPLOADS_VOLUME=

# Each key decrypts the matching API app's encrypted .env.prd file.
ADMIN_API_DOTENV_PRIVATE_KEY_PRD=
SERVICE_API_DOTENV_PRIVATE_KEY_PRD=

# Separate session keys for each web app; keep each stable across its replicas.
ADMIN_WEB_SESSION_SECRET=
SERVICE_WEB_SESSION_SECRET=
