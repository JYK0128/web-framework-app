# Use verified server settings; no production defaults are supplied.
APP_REVISION=
APPS_RUNTIME_NETWORK=
ADMIN_API_PORT=
ADMIN_WEB_PORT=
SERVICE_API_PORT=
SERVICE_WEB_PORT=
ADMIN_WEB_URL=

ADMIN_API_IMAGE=
ADMIN_WEB_IMAGE=
SERVICE_API_IMAGE=
SERVICE_WEB_IMAGE=

# Existing external volumes only. Do not point both APIs at the same uploads volume.
ADMIN_API_UPLOADS_VOLUME=
SERVICE_API_UPLOADS_VOLUME=

# Public browser build settings for admin-web. GitHub Actions reads these from
# repository Variables when publishing images.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_IDENTITY_VERIFICATION_CHANNEL_KEY=

# Runtime decryption keys, encrypted along with this Compose configuration.
ADMIN_API_DOTENV_PRIVATE_KEY_PRD=
ADMIN_WEB_DOTENV_PRIVATE_KEY_PRD=
SERVICE_API_DOTENV_PRIVATE_KEY_PRD=
SERVICE_WEB_DOTENV_PRIVATE_KEY_PRD=
