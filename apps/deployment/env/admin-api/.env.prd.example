# Encrypted API runtime values. Copy to .env.prd, fill in values, then encrypt with dotenvx.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use the same APP_SECRET in service-api/.env.prd.
APP_SECRET=
DATABASE_URL=
REDIS_URL=
PORTONE_API_SECRET=
# Required only when S3 storage is used.
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Set true only for an isolated demo database; all admin data is truncated and reseeded hourly.
DEMO_ENABLED=false
