# Standalone local web runtime/build. Docker Compose gets deployment values separately.
NODE_ENV=development
PORT=3000
APP_NAME=service
API_BASE_URL=http://localhost:4000
API_SPEC_URL=http://localhost:4000/api/docs-json
VITE_PORTONE_STORE_ID=replace-with-portone-store-id
VITE_PORTONE_CHANNEL_KEY=replace-with-portone-channel-key
VITE_ADMIN_WEB_URL=http://localhost:13000

APP_BASE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-character-session-secret
