# Standalone local web runtime/build. Docker Compose gets deployment values separately.
NODE_ENV=development
PORT=13000
APP_NAME=admin
API_BASE_URL=http://localhost:14000
API_SPEC_URL=http://localhost:14000/api/docs-json
VITE_PORTONE_STORE_ID=replace-with-portone-store-id
VITE_PORTONE_CHANNEL_KEY=replace-with-portone-channel-key

APP_BASE_URL=http://localhost:13000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-character-session-secret
