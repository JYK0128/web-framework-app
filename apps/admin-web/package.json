{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "codegen:api": "orval",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"*.config.{js,mjs,cjs,ts,mts,cts}\" --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:service-settings": "playwright test --config playwright.service-settings.config.ts",
    "test:e2e:cross-app": "playwright test --config playwright.service-settings.config.ts e2e-integration/cross-app-responses.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@pkg/shared": "workspace:*",
    "@portone/browser-sdk": "0.1.9",
    "@tanstack/history": "1.162.0",
    "@tanstack/react-form": "1.33.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.20",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.37",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "axios": "1.8.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-middleware": "3.9.8",
    "input-otp": "1.4.2",
    "jotai": "3.0.0",
    "lucide-react": "1.28.0",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "nitro": "3.0.260610-beta",
    "orval": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.0"
  },
  "files": [
    ".output"
  ]
}
