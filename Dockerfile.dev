# ==============================================================================
# Development Dockerfile (pnpm fetch & cache optimized)
# ==============================================================================
FROM node:24-alpine AS base

# pnpm 활성화 및 네이티브 빌드 필수 도구 설치
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
RUN apk add --no-cache libc6-compat git python3 make g++ lsof

WORKDIR /app

# 1. Lockfile 및 workspace 설정 파일 복사
COPY pnpm-lock.yaml pnpm-workspace.yaml ./

# 2. pnpm fetch로 가상 스토어에 의존성 사전 다운로드 (Docker 레이어 캐시)
RUN pnpm fetch

# 3. 패키지 manifest 파일들 복사
COPY package.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY template/nest-starter-kit/package.json ./template/nest-starter-kit/
COPY template/react-starter-kit/package.json ./template/react-starter-kit/
COPY template/npm-starter-kit/package.json ./template/npm-starter-kit/

# 4. 패키지 소스 복사 (내부 workspace:* 의존성 링크용)
COPY packages ./packages

# 5. 오프라인 설치 (스토어 캐시를 사용하여 초고속 심링크 연결)
RUN pnpm install --offline --frozen-lockfile

ENV NODE_ENV=development
