{
  "name": "nest-auth-server-starter-kit",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS + MikroORM session authentication server starter kit",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "pnpm build && cross-env NODE_ENV=development dotenvx run --convention=nextjs -- concurrently -k \"node esbuild.config.js --watch\" \"nodemon --watch dist/main.js --ext js dist/main.js\"",
    "start": "cross-env NODE_ENV=production dotenvx run --convention=nextjs -- node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "db:entities:generate": "dotenvx run --convention=nextjs -- mikro-orm discovery:export --path './src/entities/**/*.entity.ts' --out ./src/entities.generated.ts",
    "db:migrate": "dotenvx run --convention=nextjs -- mikro-orm migration:up",
    "db:migrate:create": "dotenvx run --convention=nextjs -- mikro-orm migration:create",
    "db:seed": "dotenvx run --convention=nextjs -- mikro-orm seeder:run"
  },
  "packageManager": "pnpm@10.32.1",
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts",
      "./dist/database/mikro-orm.config.js"
    ],
    "preferTs": true,
    "tsLoader": "swc",
    "tsConfigPath": "./tsconfig.app.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mikro-orm/core": "7.1.9",
    "@mikro-orm/decorators": "7.1.9",
    "@mikro-orm/migrations": "7.1.9",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/seeder": "7.1.9",
    "@mikro-orm/sqlite": "7.1.9",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.1.9",
    "@pkg/config": "workspace:*",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.46",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "concurrently": "10.0.4",
    "esbuild": "0.25.12",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-swc": "1.0.1",
    "nodemon": "3.1.14",
    "typescript": "5.9.3"
  }
}
