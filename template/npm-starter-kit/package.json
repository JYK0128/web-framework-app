{
  "name": "npm-starter-kit",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "license": "ISC",
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@pkg/shared": "workspace:*"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@swc/core": "1.15.47",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "esbuild-node-externals": "2.0.0",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-plugin-swc": "1.0.1",
    "eslint": "10.8.0",
    "typescript": "5.9.3"
  }
}
