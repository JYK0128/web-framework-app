{
  "name": "npm-starter-kit",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "license": "ISC",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild build --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@pkg/shared": "workspace:*"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@rsbuild/core": "^2.0.0",
    "@types/node": "26.1.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
