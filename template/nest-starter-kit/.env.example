APP_NAME=AntigravityApp
NODE_ENV=development
APP_SECRET=development-only-change-this-secret-1234567890
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379
# OAuth
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
FRONTEND_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# Nodemailer / SMTP (Optional - in development without SMTP, emails will fallback to logging)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=noreply@example.com

# Slack Incoming Webhook (Optional - for alerts and notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx


