# Application
APP_NAME="Service Factory"
NODE_ENV=development
BACKEND_PORT=4000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-43-character-base64url-key

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_db
REDIS_URL=redis://localhost:6379

# Service URLs
FRONTEND_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# PortOne Identity Verification
PORTONE_API_SECRET=replace-with-portone-api-secret
