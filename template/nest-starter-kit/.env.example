# Application
APP_NAME=web-framework-app
NODE_ENV=development
PORT=4000
APP_SECRET=your-32-byte-or-longer-app-secret-here-1234567890

# Database and cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_db
REDIS_URL=redis://localhost:6379

# Service URLs
FRONTEND_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# Google OAuth
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Nodemailer / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=noreply@example.com

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# PortOne Identity Verification
PORTONE_API_SECRET=replace-with-portone-api-secret
