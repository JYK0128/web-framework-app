NODE_ENV=development
PORT=4000
DATABASE_PATH=./data/auth.sqlite3
SESSION_TTL_SECONDS=2592000
SESSION_SECRET=development-only-change-this-secret-1234567890
BCRYPT_SALT_ROUNDS=12
COOKIE_NAME=auth_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000

# Required only for pnpm db:seed
SEED_USER_EMAIL=seed@example.com
SEED_USER_PASSWORD=change-this-password
SEED_USER_NAME=Seed User

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
