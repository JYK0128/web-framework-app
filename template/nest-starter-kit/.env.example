APP_NAME=AntigravityApp
NODE_ENV=development
APP_SECRET=development-only-change-this-secret-1234567890
PORT=4000
DATABASE_URL=sqlite:///./data/auth.sqlite3
SESSION_TTL_SECONDS=1800
SESSION_ROLLING_THRESHOLD_SECONDS=600
COOKIE_NAME=auth_session
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000

# Password & Auth Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_EXPIRATION_DAYS=90
PASSWORD_POLICY_REGEX=^(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$

# Required only for pnpm db:seed
SEED_USER_EMAIL=test@test.com
SEED_USER_PASSWORD=test1234!
SEED_USER_NAME=Seed User

# OAuth
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
