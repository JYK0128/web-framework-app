APP_NAME=AntigravityApp
NODE_ENV=development
APP_SECRET=development-only-change-this-secret-1234567890
PORT=4000
DATABASE_URL=sqlite:///./data/auth.sqlite3
SESSION_TTL_SECONDS=2592000
COOKIE_NAME=auth_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000

# Required only for pnpm db:seed
SEED_USER_EMAIL=seed@example.com
SEED_USER_PASSWORD=change-this-password
SEED_USER_NAME=Seed User

# OAuth
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
