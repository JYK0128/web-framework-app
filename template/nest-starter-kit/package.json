{
  "name": "nest-starter-kit",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS + MikroORM session authentication server starter kit",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "predev": "pnpm db:migrate && pnpm db:seed && pnpm build",
    "dev": "concurrently -k \"node esbuild.config.js --watch\" \"dotenvx run -f ../../docker/compose/.env.dev.nest -- nodemon\"",
    "start": "cross-env NODE_ENV=production dotenvx run -f ../../docker/compose/.env.prd.nest -- node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "codegen:entities": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm discovery:export --path './src/entities/**/*.entity.ts' --out ./src/entities.generated.ts",
    "codegen:migration": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm migration:create",
    "db:migrate": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm migration:up",
    "db:migrate:prd": "dotenvx run -f ../../docker/compose/.env.prd.nest -- mikro-orm migration:up",
    "db:migrate:down": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm migration:down",
    "db:migrate:down:prd": "dotenvx run -f ../../docker/compose/.env.prd.nest -- mikro-orm migration:down",
    "db:seed": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm seeder:run",
    "db:seed:prd": "dotenvx run -f ../../docker/compose/.env.prd.nest -- mikro-orm seeder:run",
    "db:reset": "dotenvx run -f ../../docker/compose/.env.dev.nest -- mikro-orm schema:drop --run --drop-migrations-table && pnpm db:migrate && pnpm db:seed"
  },
  "packageManager": "pnpm@10.32.1",
  "mikro-orm": {
    "configPaths": [
      "./src/infra/database/mikro-orm.config.ts",
      "./dist/infra/database/mikro-orm.config.js"
    ],
    "preferTs": true,
    "tsLoader": "swc",
    "tsConfigPath": "./tsconfig.app.json"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.10",
    "@mikro-orm/decorators": "7.1.10",
    "@mikro-orm/migrations": "7.1.10",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/postgresql": "7.1.10",
    "@mikro-orm/seeder": "7.1.10",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@pkg/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "date-fns": "4.4.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nestjs-cls": "6.2.1",
    "nodemailer": "9.0.5",
    "otplib": "13.4.1",
    "qrcode": "1.5.4",
    "redis": "5.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.19.2",
    "@mikro-orm/cli": "7.1.10",
    "@pkg/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "esbuild": "0.28.1",
    "esbuild-node-externals": "2.0.0",
    "esbuild-plugin-copy": "2.1.1",
    "eslint": "9.39.5",
    "nodemon": "3.1.14",
    "typescript": "5.9.3"
  }
}
