{
  "name": "nest-starter-kit",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS + MikroORM session authentication server starter kit",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "predev": "lsof -ti:4000 | xargs kill -9 2>/dev/null; true",
    "dev": "cross-env NODE_ENV=development dotenvx run --convention=nextjs -- nodemon --watch src --ext ts --delay 1 --exec \"node esbuild.config.js && node dist/main.js\"",
    "start": "cross-env NODE_ENV=production dotenvx run --convention=nextjs -- node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "db:entities:generate": "dotenvx run --convention=nextjs -- mikro-orm discovery:export --path './src/entities/**/*.entity.ts' --out ./src/entities.generated.ts",
    "db:migrate": "dotenvx run --convention=nextjs -- mikro-orm migration:up",
    "db:migrate:create": "dotenvx run --convention=nextjs -- mikro-orm migration:create",
    "db:seed": "dotenvx run --convention=nextjs -- mikro-orm seeder:run"
  },
  "packageManager": "pnpm@10.32.1",
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts",
      "./dist/database/mikro-orm.config.js"
    ],
    "preferTs": true,
    "tsLoader": "swc",
    "tsConfigPath": "./tsconfig.app.json"
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.10",
    "@mikro-orm/decorators": "7.1.10",
    "@mikro-orm/migrations": "7.1.10",
    "@mikro-orm/nestjs": "7.0.2",
    "@mikro-orm/seeder": "7.1.10",
    "@mikro-orm/sql-highlighter": "1.0.1",
    "@mikro-orm/sqlite": "7.1.10",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@pkg/shared": "workspace:*",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "nestjs-cls": "6.2.1",
    "otplib": "13.4.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.19.2",
    "@mikro-orm/cli": "7.1.10",
    "@pkg/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "cross-env": "10.1.0",
    "esbuild": "0.28.1",
    "esbuild-node-externals": "2.0.0",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-plugin-swc": "1.0.1",
    "eslint": "9.39.5",
    "nodemon": "3.1.14",
    "typescript": "5.9.3"
  }
}
