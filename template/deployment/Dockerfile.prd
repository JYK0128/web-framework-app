FROM node:24-alpine AS base

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
RUN apk add --no-cache libc6-compat git python3 make g++ tini curl \
  && curl -sfS https://dotenvx.sh | sh \
  && apk del curl

WORKDIR /app

FROM base AS builder

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

COPY package.json turbo.json ./
COPY packages ./packages
COPY template ./template

RUN pnpm install --frozen-lockfile --offline
RUN --mount=type=secret,id=DOTENV_PRIVATE_KEY_PRD \
    --mount=type=secret,id=DOTENV_PRD \
    DOTENV_PRIVATE_KEY_PRD="$(cat /run/secrets/DOTENV_PRIVATE_KEY_PRD)" \
      dotenvx run -f /run/secrets/DOTENV_PRD -- pnpm build

FROM base AS runner

COPY --from=builder /app ./

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["dotenvx", "run", "-f", "template/deployment/env/.env.prd", "--", "pnpm", "start"]
