# OpenAPI / Swagger Spec URL (Used by Orval code generator)
API_SPEC_URL=http://localhost:4000/api/v1/docs-json

# Server-only backend target
BACKEND_URL=http://localhost:4000

# Frontend origin used by SSR API requests
FRONTEND_URL=http://localhost:3000

# Redis session store
REDIS_URL=redis://localhost:6379

# Server Port
PORT=3000
