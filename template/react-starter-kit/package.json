{
  "name": "react-starter-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development dotenvx run --convention=nextjs -- vite",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production dotenvx run --convention=nextjs -- node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "gen:api": "dotenvx run -- orval"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@pkg/shared": "workspace:*",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-form": "1.33.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.20",
    "@tanstack/react-start": "1.168.37",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@toast-ui/editor": "3.2.2",
    "@toast-ui/react-editor": "3.2.3",
    "axios": "1.8.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lodash-es": "4.18.1",
    "lucide-react": "1.28.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.2",
    "recharts": "3.10.1",
    "shadcn": "4.16.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.19.2",
    "@pkg/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/router-generator": "1.167.23",
    "@tanstack/router-plugin": "1.168.25",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "nitro": "3.0.260610-beta",
    "orval": "8.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  }
