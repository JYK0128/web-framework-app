{
  "name": "iOS Viewport 안정화 데모",
  "short_name": "Viewport Demo",
  "description": "가상 키보드와 VisualViewport 레이아웃을 확인하는 PWA 데모",
  "lang": "ko-KR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#0b1020",
  "background_color": "#f0f9ff",
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any maskable"
    }
  ]
}
