{
  "name": "web-framework-app",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up --build --watch --remove-orphans",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down -v --remove-orphans",
    "docker:prd": "docker compose --env-file docker/.env --profile cloudflare -f docker/docker-compose.prd.yml up -d --build",
    "docker:prd:down": "docker compose -f docker/docker-compose.prd.yml down",
    "docker:clean": "docker volume prune -f && docker builder prune -f",
    "db:reset": "pnpm --filter nest-starter-kit db:reset",
    "env:archive": "./tools/archive-env.sh",
    "env:restore": "./tools/restore-env.sh",
    "lint": "turbo run lint",
    "packages:list": "pnpm --recursive list --depth -1",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "turbo run typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "eslint": "9.39.5",
      "@eslint/js": "9.39.5"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "bcrypt"
    ]
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "turbo": "2.10.8",
    "typescript": "5.9.3"
  }
}
