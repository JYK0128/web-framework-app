{
  "name": "web-framework-app",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:dev": "pnpm --dir template/deployment run dev",
    "docker:down": "pnpm --dir template/deployment run dev:down",
    "docker:apps:dev": "pnpm --dir apps/deployment run dev",
    "docker:apps:down": "pnpm --dir apps/deployment run dev:down",
    "docker:clean": "docker volume prune -f && docker builder prune -f",
    "deploy:template": "pnpm --dir template/deployment run deploy",
    "db:migrate": "pnpm --filter nest-starter-kit db:migrate",
    "db:migrate:down": "pnpm --filter nest-starter-kit db:migrate:down",
    "db:reset": "pnpm --filter nest-starter-kit db:reset",
    "db:rollup": "pnpm --filter nest-starter-kit db:rollup",
    "lint": "turbo run lint",
    "packages:list": "pnpm --recursive list --depth -1",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3",
      "eslint": "9.39.5",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "@types/node": "26.1.2"
    }
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.19.2",
    "@pkg/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "husky": "9.1.7",
    "turbo": "2.10.8",
    "typescript": "5.9.3"
  }
}
