FROM node:24-alpine AS base

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
RUN apk add --no-cache libc6-compat git python3 make g++ tini curl \
  && curl -sfS https://dotenvx.sh | sh \
  && apk del curl

WORKDIR /app

FROM base AS builder

ARG DOTENV_PRIVATE_KEY_PRD

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

COPY package.json turbo.json ./
COPY packages ./packages
COPY template ./template
COPY docker/env ./docker/env

RUN pnpm install --frozen-lockfile --offline
RUN if [ -n "$DOTENV_PRIVATE_KEY_PRD" ]; then \
      DOTENV_PRIVATE_KEY_PRD=$DOTENV_PRIVATE_KEY_PRD dotenvx run -f docker/env/.env.prd -- pnpm build; \
    elif [ -f "docker/env/.env.keys" ]; then \
      dotenvx run -f docker/env/.env.keys -f docker/env/.env.prd -- pnpm build; \
    else \
      pnpm build; \
    fi

FROM base AS runner

COPY --from=builder /app ./
COPY docker/env ./docker/env

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["dotenvx", "run", "-f", "docker/env/.env.prd", "--", "pnpm", "start"]
