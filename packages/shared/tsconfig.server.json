{
  "extends": "@pkg/config/typescript/bundler",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#*": ["./src/*"]
    },
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/policy/auth/**/*", "src/constants/**/*", "src/common/**/*", "src/server/**/*", "src/policy/operation.ts", "src/policy/maintenance.ts"]
}
