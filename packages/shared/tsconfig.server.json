{
  "extends": "@pkg/config/typescript/bundler",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#*": ["./src/*"]
    },
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src/auth/**/*", "src/common/**/*", "src/server/**/*"]
}
