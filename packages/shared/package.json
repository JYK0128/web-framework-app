{
  "name": "@pkg/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "default": "./src/common/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./web": {
      "types": "./src/web/index.tsx",
      "default": "./src/web/index.tsx"
    }
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --build"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@kokr/date": "0.4.0",
    "bcrypt": "6.0.0",
    "consola": "3.4.2",
    "date-fns": "4.4.0",
    "es-hangul": "2.4.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-middleware": "3.9.8",
    "libphonenumber-js": "1.13.11",
    "lodash-es": "4.18.1",
    "maskdata": "1.3.4",
    "uuid": "14.0.1",
    "zod": "4.4.3",
    "zod-i18n-map": "2.27.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "typescript": "5.9.3"
  }
}
