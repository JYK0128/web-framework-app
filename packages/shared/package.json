{
  "name": "@pkg/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "default": "./src/common/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*/index.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --build"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "bcrypt": "6.0.0",
    "consola": "3.4.2",
    "date-fns": "4.4.0",
    "es-hangul": "2.4.0",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-middleware": "3.9.8",
    "libphonenumber-js": "1.13.11",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/i18next-node-fs-backend": "2.1.5",
    "@types/node": "25.2.3",
    "typescript": "5.9.3"
  }
}
