{
  "name": "@pkg/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "default": "./src/common/index.ts"
    },
    "./constants": {
      "types": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./policy": {
      "types": "./src/policy/index.ts",
      "default": "./src/policy/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./web/browser-environment": {
      "types": "./src/web/browser-environment.ts",
      "default": "./src/web/browser-environment.ts"
    },
    "./web/cookie": {
      "types": "./src/web/cookie.ts",
      "default": "./src/web/cookie.ts"
    }
  },
  "imports": {
    "#*": [
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --build"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "consola": "3.4.2",
    "date-fns": "4.4.0",
    "es-hangul": "2.4.0",
    "i18next": "26.3.6",
    "libphonenumber-js": "1.13.11",
    "maskdata": "1.3.4",
    "sanitize-html": "2.18.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@pkg/config": "workspace:*",
    "@types/node": "26.1.2",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
